# Existing required server configuration
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Admin password: at least 16 characters; enter a strong unique value securely.
ADMIN_PASSWORD=
# Independent random signing secret: at least 32 characters, never reuse the password.
ADMIN_SESSION_SECRET=
# Exact canonical origin, also required for admin CSRF and session audience checks.
NEXT_PUBLIC_SITE_URL=

# Payment stays manual until Culqi is approved and keys are available.
PAYMENT_PROVIDER=manual
CULQI_ENABLED=false
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
NEXT_PUBLIC_CULQI_RSA_ID=
NEXT_PUBLIC_CULQI_RSA_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Optional monitoring
MONITORING_ALERT_WEBHOOK_URL=
