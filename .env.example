# Template only. Keep real values in the approved environment's secret manager.
# This file does not configure a deployment or authorize provider transactions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payment adapters exist, but the PR47 storefront intentionally remains review-only.
# Merchant approval is not equivalent to technical integration or live authorization.
PUBLIC_SITE_URL=
PAYMENT_PROVIDER=manual
CULQI_MODE=disabled
CULQI_ENABLED=false
CULQI_LIVE_APPROVED=false
BAGELITO_MERCHANT_REVIEW_ONLY=true
BAGELITO_REFERENCE_REVIEW_ONLY=true
CULQI_TANSTACK_BRIDGE_READY=false
CULQI_TANSTACK_WEBHOOK_READY=false
CULQI_TANSTACK_CLIENT_READY=false
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_RSA_ID=
CULQI_RSA_PUBLIC_KEY=
# Draft-only full-product lane. Requires sandbox, same-origin intake and the
# separately approved SQL policy. Never live/production; this is not activation.
BAGELITO_GUIDED_PRODUCT_CHECKOUT_ENABLED=false
# See docs/payment-readiness-20261102.md before an authorized isolated sandbox setup.

# Optional contact-only backup at /consulta. No activation is implied.
# Requires an approved deployment and exact HTTPS origin (HTTP only for loopback QA).
# Never enables payments.
BAGELITO_MANUAL_INQUIRY_ENABLED=false
BAGELITO_MANUAL_INQUIRY_ORIGIN=
