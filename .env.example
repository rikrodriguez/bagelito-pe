# Existing required server configuration
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=

# Payment stays manual until Culqi is approved and keys are available.
PAYMENT_PROVIDER=manual
CULQI_ENABLED=false
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
NEXT_PUBLIC_CULQI_RSA_ID=
NEXT_PUBLIC_CULQI_RSA_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Instagram Inbox Agent — server only. Never prefix these with NEXT_PUBLIC_.
# Phase 1 is shadow mode: receive/store/analyze, never auto-send.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USERNAME=bagelito.pe
INSTAGRAM_AUTOMATION_MODE=shadow

# Optional AI provider for Shadow Mode suggestions. Server only.
OPENAI_API_KEY=
INSTAGRAM_AI_MODEL=gpt-6-astra

# HighLevel CRM sync — server only. Create the token as a Private Integration
# for the RikMarketing sub-account and grant the contact, opportunity, pipeline,
# and custom-field scopes used by the Bagelito CRM worker.
GHL_API_TOKEN=
GHL_API_VERSION=2021-07-28
GHL_LOCATION_ID=wGVp4L7zAl46JR7gg0Hx

# Optional monitoring
MONITORING_ALERT_WEBHOOK_URL=
